@echo off
REM Скрипт автозапуска торгового бота в фоновом режиме
REM Запускает бота даже если компьютер в спящем режиме (при условии отключения спящего режима)

cd /d "%~dp0"
echo ========================================
echo Запуск торгового бота (фоновый режим)
echo ========================================
echo.

REM Проверяем наличие Python
python --version >nul 2>&1
if errorlevel 1 (
    echo ОШИБКА: Python не найден!
    echo Установите Python и добавьте его в PATH
    pause
    exit /b 1
)

REM Запускаем бота
echo Запуск бота...
python trading_bot_background.py

REM Если бот завершился с ошибкой, пауза для просмотра
if errorlevel 1 (
    echo.
    echo Бот завершился с ошибкой!
    pause
)
